rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for ID validation
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Collection: Users (User profiles & RBAC for Nutricionista, Deportista, Entrenador)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Collection: Athletes Profile & all nested subcollections (dailyLogs, nutritionPlans, injuries)
    match /athletes/{athleteId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Collection: Recipes (Catalog & custom sports recipes)
    match /recipes/{recipeId} {
      allow read, create: if true;
      allow update, delete: if true;
    }
  }
}
