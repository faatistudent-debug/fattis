rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDate(date) {
      return date is string && date.size() == 10 && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isNutritionist() {
      return hasUserDoc() && getUserRole() == 'Nutricionista';
    }

    function isCoach() {
      return hasUserDoc() && getUserRole() == 'Entrenador';
    }

    function isStaff() {
      return isNutritionist() || isCoach();
    }

    // Entity Validators
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.role in ['Deportista', 'Nutricionista', 'Entrenador'];
    }

    function isValidDayHabitLog(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.date is string && isValidDate(data.date)
        && data.waterGlasses is number && data.waterGlasses >= 0 && data.waterGlasses <= 30
        && (!('moodNote' in data) || (data.moodNote is string && data.moodNote.size() <= 1000))
        && (!('customMeals' in data) || (data.customMeals is list && data.customMeals.size() <= 25));
    }

    function isValidRecipe(data) {
      return data.id is string && isValidId(data.id)
        && data.authorId is string && data.authorId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.category is string && data.category.size() <= 100;
    }

    function isValidNutritionPlan(data) {
      return data.id is string && isValidId(data.id)
        && data.authorId is string && data.authorId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200;
    }

    function isValidInjury(data) {
      return data.id is string && isValidId(data.id)
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.status in ['Activa', 'En recuperación', 'Dada de alta']
        && data.severity in ['Leve', 'Moderada', 'Grave'];
    }

    // Collection: Users
    match /users/{userId} {
      allow get: if isOwner(userId) || isStaff();
      allow list: if isStaff();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data)
                    && request.resource.data.role == resource.data.role; // Prevent self-elevation of role
      allow delete: if false; // User accounts are retained
    }

    // Collection: Athletes Profile
    match /athletes/{athleteId} {
      allow get: if isOwner(athleteId) || isStaff();
      allow list: if isStaff();
      allow create, update: if isOwner(athleteId) && isValidId(athleteId);
      allow delete: if false;

      // Subcollection: Daily Logs (Meals, Breakfast photos, Hydration, Sleep)
      match /dailyLogs/{date} {
        allow get: if isOwner(athleteId) || isStaff();
        allow list: if isOwner(athleteId) || isStaff();
        allow create: if isOwner(athleteId) && isValidDate(date) && isValidDayHabitLog(request.resource.data);
        allow update: if isOwner(athleteId) && isValidDate(date) && isValidDayHabitLog(request.resource.data);
        allow delete: if isOwner(athleteId);
      }

      // Subcollection: Nutrition Plans
      match /nutritionPlans/{planId} {
        allow get, list: if isOwner(athleteId) || isStaff();
        allow create, update, delete: if isNutritionist() && isValidId(planId) && isValidNutritionPlan(request.resource.data);
      }

      // Subcollection: Injuries
      match /injuries/{injuryId} {
        allow get, list: if isOwner(athleteId) || isStaff();
        allow create, update, delete: if isCoach() && isValidId(injuryId) && isValidInjury(request.resource.data);
      }
    }

    // Collection: Recipes (Public read, Nutritionist write)
    match /recipes/{recipeId} {
      allow get, list: if isSignedIn();
      allow create: if isNutritionist() && isValidId(recipeId) && isValidRecipe(request.resource.data);
      allow update: if isNutritionist() && isValidId(recipeId) && isValidRecipe(request.resource.data)
                    && (resource.data.authorId == request.auth.uid || resource.data.authorId == '');
      allow delete: if isNutritionist() && isValidId(recipeId)
                    && (resource.data.authorId == request.auth.uid || resource.data.authorId == '');
    }
  }
}
